<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Naveasy.Shell.Samples.Views.Guard.GuardedPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:guard="clr-namespace:Naveasy.Shell.Samples.Views.Guard"
             x:DataType="guard:GuardedPageViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="30,20"
                         Spacing="15">
        <Label Text="{Binding Title}"
               Style="{StaticResource Headline}" />

        <Label Text="While there are unsaved changes, leaving this page asks for confirmation." />

        <Switch IsToggled="{Binding HasUnsavedChanges}"
                HorizontalOptions="Start" />

        <Button Text="Save the changes"
                Command="{Binding SaveCommand}" />

        <Button Text="Go back"
                Command="{Binding GoBackCommand}" />
    </VerticalStackLayout>
</ContentPage>
