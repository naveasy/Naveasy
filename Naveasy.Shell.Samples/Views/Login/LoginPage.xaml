<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Naveasy.Shell.Samples.Views.Login.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:login="clr-namespace:Naveasy.Shell.Samples.Views.Login"
             x:DataType="login:LoginPageViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="30"
                         Spacing="25"
                         VerticalOptions="Center">
        <Label Text="Naveasy.Shell"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center" />

        <Label Text="ViewModel to ViewModel navigation on top of MAUI Shell"
               HorizontalTextAlignment="Center" />

        <Button Text="Sign in"
                Command="{Binding SignInCommand}" />
    </VerticalStackLayout>
</ContentPage>
