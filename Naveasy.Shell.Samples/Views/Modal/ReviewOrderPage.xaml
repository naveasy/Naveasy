<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Naveasy.Shell.Samples.Views.Modal.ReviewOrderPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modal="clr-namespace:Naveasy.Shell.Samples.Views.Modal"
             x:DataType="modal:ReviewOrderPageViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="30"
                         Spacing="15"
                         VerticalOptions="Center">
        <Label Text="Modal page"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center" />

        <Label Text="{Binding Order.Customer, StringFormat='Reviewing the order of {0}'}"
               HorizontalTextAlignment="Center" />

        <Button Text="Close"
                Command="{Binding CloseCommand}" />
    </VerticalStackLayout>
</ContentPage>
