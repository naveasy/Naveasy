<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Naveasy.Shell.Samples.Views.Orders.OrderDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:orders="clr-namespace:Naveasy.Shell.Samples.Views.Orders"
             x:DataType="orders:OrderDetailPageViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="30,20"
                         Spacing="15">
        <Label Text="{Binding Order.Customer}"
               Style="{StaticResource Headline}" />

        <Label Text="{Binding Order.Total, StringFormat='Total: {0:C}'}" />

        <Button Text="Review (modal page)"
                Command="{Binding ReviewCommand}" />

        <Button Text="Open the customer (scoped page)"
                Command="{Binding OpenCustomerCommand}" />

        <Button Text="Approve and go back"
                Command="{Binding ApproveCommand}" />

        <Button Text="Reject and go back"
                Command="{Binding RejectCommand}" />
    </VerticalStackLayout>
</ContentPage>
