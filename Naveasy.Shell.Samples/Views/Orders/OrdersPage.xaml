<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Naveasy.Shell.Samples.Views.Orders.OrdersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Naveasy.Shell.Samples.Models"
             xmlns:orders="clr-namespace:Naveasy.Shell.Samples.Views.Orders"
             x:DataType="orders:OrdersPageViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*"
          Padding="20,10"
          RowSpacing="10">

        <Label Grid.Row="0"
               Text="{Binding LastReview}"
               IsVisible="{Binding HasReview}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Orders}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrderModel">
                    <Grid Padding="10"
                          ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type orders:OrdersPageViewModel}}, Path=OpenOrderCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0"
                               Text="{Binding Customer}" />

                        <Label Grid.Column="1"
                               Text="{Binding Total, StringFormat='{0:C}'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
