<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Naveasy.Shell.Samples.Views.Reports.SummaryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:reports="clr-namespace:Naveasy.Shell.Samples.Views.Reports"
             x:DataType="reports:SummaryPageViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="30,20"
                         Spacing="15">
        <Label Text="{Binding Total, StringFormat='Total of every order: {0:C}'}"
               Style="{StaticResource Headline}" />
    </VerticalStackLayout>
</ContentPage>
